# Demonstrates global, file-local, and local variables.
test step "scope main setup"
set sharedFromMain main-global
set file mainFileOnly main-file
set local mainLocalOnly main-local

include lib/scope-helper.slasher

test step "scope main verify"
assert value "${sharedFromMain}" == main-global
assert value "${sharedFromHelper}" == helper-global
assert value "${mainFileOnly}" == main-file
assert variable not exists helperFileOnly
assert variable not exists mainLocalOnly
assert variable not exists helperLocalOnly
