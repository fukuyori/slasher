# Server-side AI smoke script.
test step "prepare data"
set message "hello from file script"
array items alpha beta
push items gamma
assert variable exists items.length
assert value "${items.length}" == 3

test step "exercise control flow"
foreach item in items
log "item ${index}: ${item}"
endforeach

test step "recover expected failure"
try
fail "expected failure for catch smoke"
catch e
log "caught ${e.code}: ${e.message}"
finally
log "cleanup"
endtry
