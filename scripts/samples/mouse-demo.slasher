# Slasher mouse demo script.
# Coordinates are absolute screen coordinates.
# The demo moves Notepad to a predictable position first.

start notepad.exe
wait 1200
move 80 80 900 640
wait 300
mouse click 180 210 primary
text "Slasher mouse demo"
wait 200
mouse context-menu 260 210
wait 500
keys ESC
wait 200
mouse drag 180 210 430 210 left 600
wait 200
mouse wheel -120
capture selected
