# Slasher v0.2 sample: pure recursion + std/array + dialog display.
#
# Demonstrates:
# - pure recursive function with type parameters (implicit, no [T] needed)
# - std/array.concat for functional list building (avoid EFFECT push in pure code)
# - std/array.join for string concatenation
# - INTERACTIVE dialog at the end
#
# Requires Numadora v0.2 parser. Run prerequisite: allowInteractiveInput = true.

MODULE hanoi
REQUIRES (user-input)

IMPORT std/array AS array
IMPORT slasher/dialog AS dialog

# Pure: returns the move sequence to transfer n disks from `from` to `to` using `work`.
FUNC moves(n: int, from: string, to: string, work: string): array[string]
  IF n <= 0 THEN
    RETURN []
  END

  LET head = moves(n - 1, from, work, to)
  LET mid: array[string] = [from + " -> " + to]
  LET tail = moves(n - 1, work, to, from)
  RETURN array.concat(array.concat(head, mid), tail)
END

EXPORT FUNC main()
  LET steps = moves(3, "A", "C", "B")
  LET result = array.join(steps, "\n")
  dialog.message("Hanoi", result, "info")
END
