MODULE slasher_io
    EXPORT Step, Log, Wait

    FUNC Step(name: String)
        Print("__SLASHER_HOST_CALL__ slasher_io.Step " + name)
    END

    FUNC Log(message: String)
        Print(message)
    END

    FUNC Wait(ms: Int)
        Print("__SLASHER_HOST_CALL__ slasher_io.Wait " + ToString(ms))
    END
END
