# Slasher v0.2 smoke test: launch Notepad, type text, assert title.
#
# Requires Numadora v0.2 parser (Lang PR-C) and AppOps plugin host (PR-D, PR-E).
# Run prerequisite: allowInteractiveInput = true (input.text is INTERACTIVE).

MODULE notepad-check
REQUIRES (process-app, user-input, observe)

IMPORT slasher/app AS app
IMPORT slasher/input AS input
IMPORT slasher/io AS io
IMPORT slasher/test AS test

EXPORT FUNC main()
  io.step("open notepad")
  LET ref = app.start-app("notepad.exe")

  LET win = ref.wait-for-window("Notepad", 10000)
              OR FAIL "Notepad window did not appear within 10s"
              CODE "window_not_found"
  win.focus()

  io.step("type text")
  input.text("Slasher Numadora smoke")
  test.assert-foreground-title("contains", "Notepad")
END
