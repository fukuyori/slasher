# Slasher v0.2 minimal sample: display a local message box.
#
# Requires Numadora v0.2 parser. Run prerequisite: allowInteractiveInput = true.

MODULE message-box
REQUIRES (user-input)

IMPORT slasher/dialog AS dialog

EXPORT FUNC main()
  dialog.message("Slasher", "Numadora からのメッセージです。", "info")
END
