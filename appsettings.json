{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PeerMode": {
    "enabled": false,
    "displayName": "slasher-local",
    "identityPath": "config/slasher-peer-identity.json",
    "registryPath": "config/slasher-peers.json"
  },

  "Plugins": {
    "WindowsNative": {
      "enabled": true
    },

    "Browser": {
      "enabled": true,
      "defaultBrowser": "edge",
      "webDriverPath": null,
      "downloadDir": null,
      "headless": false,
      "implicitWaitMs": 0,
      "pageLoadTimeoutMs": 30000
    },

    "MacOSNative": {
      "enabled": true
    },

    "LinuxNative": {
      "enabled": true
    }
  }
}
